{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.languageServer": "Pylance",

  // Pylance: modo de tipos desligado (projeto Django sem type hints) e
  // diagnóstico apenas nos arquivos abertos — elimina erros falsos do editor
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.diagnosticMode": "openFiles",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,
  "python.analysis.autoSearchPaths": true,
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "information",
    "reportMissingModuleSource": "none",
    "reportUndefinedVariable": "warning",
    "reportGeneralTypeIssues": "none"
  },

  // Django
  "python.analysis.djangoSettingsModule": "core.settings",
  "django.enabled": true,

  // Bootstrap IntelliSense
  "bootstrapIntelliSense": {
    "enable": true,
    "bsVersion": "5.3.8",
    "showSuggestions": true,
    "autoComplete": true
  },

  // Associações de arquivo
  "files.associations": {
    "*.html": "html",
    "*.django": "django-html",
    "*.jinja": "django-html",
    "*.jinja2": "django-html",
    "*.djhtml": "django-html",
    "*.css": "css",
    "*.scss": "scss",
    "*.js": "javascript",
    "*.jsx": "javascriptreact"
  },

  "emmet.includeLanguages": {
    "django-html": "html",
    "javascript": "javascriptreact"
  },

  // Validações: não reclamar de JS/CSS inline nos templates Django
  "html.validate.scripts": false,
  "html.validate.styles": false,
  "html.suggest.html5": true,
  "css.validate": false,
  "css.completion.triggerPropertyValueCompletion": true,
  "css.completion.completePropertyWithSemicolons": true,

  "javascript.suggest.completeFunctionCalls": true,
  "javascript.suggest.names": true,

  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": true
  },
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.wordWrap": "on",
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // Formatadores (instalar as extensões recomendadas em extensions.json)
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  "[django-html]": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    }
  },

  // Arquivos que não devem aparecer nem atrapalhar a busca
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.venv": true,
    "**/staticfiles": true,
    "**/.pytest_cache": true,
    "**/.coverage": true,
    "**/htmlcov": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/.venv": true,
    "**/staticfiles": true
  },

  "css.peek.paths": [
    "static/css",
    "**/static/css"
  ]
}
